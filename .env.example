# Variables locales del servidor de la caja (apps/server).
# Copia este archivo a `.env` en la raíz del repo y complétalo:
#   cp .env.example .env
# `.env` está en .gitignore: nunca lo commitees (ahí va tu correo).
# Las variables que vengan del entorno ganan sobre las del archivo.
# Una variable vacía cuenta como no definida.

# Contacto (email o URL) para el User-Agent de Open Food Facts:
#   AlmacenPOS/<versión> (<ALMACEN_CONTACTO>)
# OFF lo exige para usar su API. Si queda vacío, la consulta en línea se apaga y la caja
# solo busca en el local y en la semilla.
ALMACEN_CONTACTO=

# Pon 0 para apagar la consulta en línea a Open Food Facts aunque haya contacto.
# Vacío o cualquier otro valor = encendida (solo si ALMACEN_CONTACTO tiene valor).
ALMACEN_OFF=

# Ruta a la base semilla de productos (la genera `pnpm data:build`).
# Vacío = data/out/seed.sqlite del repo. Si usas una ruta relativa, se toma desde
# apps/server (la carpeta donde corre `pnpm dev:server`); mejor usa una absoluta.
# Si el archivo no existe, el servidor arranca igual, sin semilla.
ALMACEN_SEMILLA=

# Valor inicial de la URL de apps/cloud. Después se puede cambiar en la app:
# Configuración → Nube y respaldo cifrado. Sin URL la caja funciona local y offline.
CLOUD_URL=

# Clave local de 32 bytes que cifra el certificado y los CAF del SII (Fase 5).
# Vacío = var/sii.key (se genera con permisos 600 al cargar el certificado). No la commitees
# y respáldala: si se pierde, hay que volver a cargar el certificado y los CAF.
ALMACEN_SII_KEY=

# Clave local que cifra los respaldos que se suben a la nube (Fase 6).
# Vacío = <carpeta de la base>/respaldo.key. Descárgala desde Configuración y guárdala fuera
# del equipo: sin ella no se pueden restaurar los respaldos remotos.
ALMACEN_RESPALDO_KEY=

# Carpeta de respaldos automáticos de la base (Fase 6). Vacío = <carpeta de la base>/respaldos.
# Copia esta carpeta a un disco externo o a la nube: el respaldo local no sirve si se pierde
# el equipo.
ALMACEN_RESPALDOS=

# Interfaz donde escucha la nube (apps/cloud). Para probar desde el teléfono en la misma
# Wi-Fi, usa 0.0.0.0 y apunta EXPO_PUBLIC_CLOUD_URL a la IP local del Mac.
CLOUD_HOST=

# URL de la base PostgreSQL de la nube (Supabase) para apps/cloud (ADR-007).
# En el panel de Supabase: Project Settings → Database → Connection string (URI).
# Ahí va la clave de la base: no la commitees. Sin esta variable, `pnpm dev:cloud` no arranca.
CLOUD_DATABASE_URL=

# "JWT secret" del proyecto Supabase (Project Settings → API → JWT Settings). Con él,
# apps/cloud valida el JWT que trae la app del dueño al iniciar sesión. Sin esta variable
# el login del dueño queda deshabilitado (los endpoints responden 401).
SUPABASE_JWT_SECRET=

# URL del proyecto Supabase. Se usa para validar el JWT contra su JWKS (proyectos nuevos
# con claves asimétricas ES256). Si está definida, tiene prioridad sobre el JWT secret.
SUPABASE_URL=

# Clave service_role de Supabase (Project Settings → API). Solo la usa apps/cloud para subir
# los respaldos cifrados a Storage. NUNCA va en la caja ni en la app móvil.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket privado de Supabase Storage para respaldos. Debe existir y ser privado.
SUPABASE_STORAGE_BUCKET=respaldos
