{
  "name": "almacen-pos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:pos": "node scripts/pendiente.mjs dev:pos 3",
    "dev:mobile": "node scripts/pendiente.mjs dev:mobile 4",
    "dev:cloud": "node scripts/pendiente.mjs dev:cloud 4",
    "dev:server": "pnpm --filter @almacen/server dev",
    "data:build": "pnpm --filter @almacen/data build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "db:seed": "pnpm --filter @almacen/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
