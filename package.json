{
  "name": "almacen-pos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22"
  },
  "scripts": {
    "dev:pos": "node scripts/verificar-node.mjs && pnpm --parallel --filter @almacen/server --filter @almacen/pos dev",
    "dev:pos:app": "node scripts/verificar-node.mjs && pnpm --filter @almacen/pos tauri dev",
    "dev:mobile": "node scripts/verificar-node.mjs && pnpm --filter @almacen/mobile start",
    "dev:cloud": "node scripts/verificar-node.mjs && pnpm --filter @almacen/cloud dev",
    "dev:server": "node scripts/verificar-node.mjs && pnpm --filter @almacen/server dev",
    "data:build": "node scripts/verificar-node.mjs && pnpm --filter @almacen/data build",
    "test": "node scripts/verificar-node.mjs && vitest run",
    "test:watch": "node scripts/verificar-node.mjs && vitest",
    "coverage": "node scripts/verificar-node.mjs && vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "db:seed": "node scripts/verificar-node.mjs && pnpm --filter @almacen/server db:seed",
    "deploy:cloud": "fly deploy . --config apps/cloud/fly.toml --dockerfile apps/cloud/Dockerfile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
