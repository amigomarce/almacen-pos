{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Almacén POS",
  "version": "0.1.0",
  "identifier": "cl.almacenpos.caja",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev:pos",
      "cwd": "../.."
    },
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Almacén POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3001 ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Caja para almacenes de barrio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/server/": "server/"
    }
  }
}
