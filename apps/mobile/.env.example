# App del dueño (apps/mobile). Copia este archivo a `apps/mobile/.env` y complétalo.
# Expo inyecta al compilar las variables que empiezan con EXPO_PUBLIC_ (no son secretas:
# la anon key de Supabase es pública por diseño; los permisos los da RLS / nuestra API).

# URL de la nube (apps/cloud). En desarrollo local, el servidor de la nube.
EXPO_PUBLIC_CLOUD_URL=http://127.0.0.1:3002

# Proyecto Supabase (Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
